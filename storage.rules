rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Sohbet dosya/resim ekleri. Boyut sınırı Flutter tarafındaki
    // _maxAttachmentBytes (10 MB) ile aynı tutulmalı.
    match /channel_attachments/{channelName}/{fileName} {
      allow read, write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
  }
}
